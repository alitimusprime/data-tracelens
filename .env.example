# Copy this file to .env. Never commit .env.
POSTGRES_DB=tracelens
POSTGRES_USER=tracelens
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://tracelens:change-me-locally@postgres:5432/tracelens
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# Browser-facing URL. Keep localhost when running with Docker Desktop.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional evidence-grounded AI explanation provider.
# The product remains fully usable when these values are blank.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

SIMULATOR_ENABLED=true
ANALYSIS_INTERVAL_SECONDS=10
INCIDENT_CORRELATION_WINDOW_SECONDS=180
PROMETHEUS_URL=http://prometheus:9090
TEMPO_URL=http://tempo:3200
LOKI_URL=http://loki:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
